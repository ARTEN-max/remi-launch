# Upstash Redis REST API. Create a database in the Vercel Marketplace
# (Upstash Redis) or at https://console.upstash.com and paste both values.
# Vercel KV-style names work too: KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token for GET /api/admin/stats and GET /api/admin/export.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=

# Public site origin, no trailing slash. Used for canonical and Open Graph URLs.
# Example: https://remi.vercel.app
# On Vercel this falls back to the production domain when unset.
# Change it, then redeploy, so share cards use the right host.
NEXT_PUBLIC_SITE_URL=
